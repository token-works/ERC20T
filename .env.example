# Copy to .env and fill in the settings you need. Never commit .env.
# Use a Foundry keystore account or hardware wallet; no private key is needed here.
MAINNET_RPC_URL=
ETHERSCAN_API_KEY=
RPC_URL=

# Generic shared infrastructure deployment (set chain-appropriate addresses).
POOL_MANAGER=
HOOK_OWNER=
PROTOCOL_FEE_RECIPIENT=
# Optional: defaults to TokenWorks on Ethereum, zero on other chains.
# GLOBAL_DISTRIBUTOR_REGISTRY=0x0000000000000000000000000000000000000000

# Token deployment through an existing hook and factory.
ERC20T_HOOK=
ERC20T_FACTORY=
POSITION_MANAGER=
PERMIT2=
TOKEN_OWNER=
FEE_RECIPIENT=
FEE_DECAY_RECIPIENT=0x0000000000000000000000000000000000000000
TOKEN_NAME="Example Token"
TOKEN_SYMBOL=EXT
TOKEN_SUPPLY=1000000000000000000000000
QUOTE_TOKEN=0x0000000000000000000000000000000000000000
TAX_BPS=100
# Zero means fixed tax; a positive interval enables decay from 99%.
TAX_DECAY_INTERVAL_SECONDS=0

# Price-based atomic launch. Example values, not a recommended valuation.
CREATOR_ALLOCATION_BPS=1000
STARTING_PRICE_WEI=10000000000000
# For an ERC20 quote: base units of that quote per whole ERC20T token.
# STARTING_PRICE_QUOTE=

# Separate token creation or explicit-range launch instead of price-based launch.
LP_SUPPLY=900000000000000000000000
# SQRT_PRICE_X96=
# TICK_LOWER=
# TICK_UPPER=
# LAUNCH_ETH=0
